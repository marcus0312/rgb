<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnifiedRgb.App.App"
             xmlns:local="using:UnifiedRgb.App"
             xmlns:vm="using:UnifiedRgb.App.ViewModels"
             RequestedThemeVariant="Dark"
             Name="Unified RGB">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/avalonia-logo.ico"
                ToolTipText="Unified RGB"
                Command="{Binding TrayShowCommand}"
                IsVisible="True">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show" Command="{Binding TrayShowCommand}" />
            <NativeMenuItem Header="Sync all" Command="{Binding TraySyncAllCommand}" />
            <NativeMenuItem Header="Load profile" IsEnabled="False" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Command="{Binding TrayExitCommand}" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
